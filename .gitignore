# Maven build output
target/
*.jar

# IDE
.idea/
*.iml
.vscode/

# Logs
*.log

# Local/backup files
*.bak
*.tmp
*.temp

# Environment and secrets
.env
.env.*
application-local.properties

# Keycloak runtime data
data/
realm-export/

# Never commit exported users/credentials
*-users-*.json

# Never commit raw realm export
realm-config/vln-poc-realm.json

# Keep only sanitized realm configuration
!realm-config/vln-poc-realm-sanitized.json